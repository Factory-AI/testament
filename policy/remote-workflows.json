    "root": ".",
    "entry_point": "make verify-publication",
    "escape_policy": "reject",
    "unrelated_repository_policy": "ignore",
    "testament_findings_policy": "block"
  },
  "publication_findings_allowlist": [
    {
      "code": "aws_access_key",
      "path": "tests/test_corpus.py",
      "line": 171,
      "match_sha256": "1a5d44a2dca19669d72edf4c4f1c27c4c1ca4b4408fbb17f6ce4ad452d78ddb3",
      "rationale": "Exact AWS documentation EXAMPLE canary used only to prove the corpus secret scanner rejects a mutated fixture.",
