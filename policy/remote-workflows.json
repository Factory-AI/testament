    }
  ],
  "maintenance_records": [
    {
      "key": "trademark-review",
      "owner": "enoreyes",
      "deduplication_marker": "testament-maintenance:trademark-review",
      "freshness": "weekly"
    },
    {
      "key": "single-maintainer-bootstrap",
      "owner": "enoreyes",
      "deduplication_marker": "testament-maintenance:single-maintainer-bootstrap",
      "expires_at": "2026-09-30",
      "freshness": "weekly"
    },
    {
      "key": "documentation-freshness",
      "owner": "enoreyes",
      "deduplication_marker": "testament-maintenance:documentation-freshness",
      "freshness": "weekly"
    },
    {
      "key": "runtime-error",
      "owner": "enoreyes",
      "deduplication_marker": "testament-maintenance:runtime-error",
      "closure_policy": "passing protected Quality run"
    }
  ],
  "emergency_bypass": {
    "standing_bypass": false,
    "actor": "repository administrator",
    "scope": "pull request only",
    "requirements": [
      "public reason and audit record",
      "explicit start and expiry",
      "normal required checks complete",
      "temporary actor entry removed immediately after use",
      "never force-push or delete main"
    ]
