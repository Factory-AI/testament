{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Factory-AI/testament/schemas/naming-clearance.schema.json",
  "title": "Testament naming-clearance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "record_id",
    "version",
    "name",
    "searched_at",
    "searches",
    "review",
    "approval",
    "legal_limitation",
    "next_review"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "feature_id": {"const": "naming-clearance-and-research-registry"},
    "record_id": {"const": "RES-STUDY-NAMING-001"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "name": {"const": "Testament"},
    "searched_at": {"type": "string", "format": "date"},
    "searches": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "query",
          "publisher",
          "title",
          "source_url",
          "accessed_at",
          "result",
          "observation",
          "inference",
          "residual_risk"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {
            "enum": [
              "trademark",
              "package",
              "repository",
              "domain",
              "standards-ecosystem",
              "confusing-similarity"
            ]
          },
          "query": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "accessed_at": {"type": "string", "format": "date"},
          "result": {"enum": ["clear", "collision", "unresolved"]},
          "observation": {"type": "string", "minLength": 1},
          "inference": {"type": "string", "minLength": 1},
          "residual_risk": {"type": "string", "minLength": 1}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "role", "status", "reviewed_at", "finding"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "reviewed_at": {"type": "string", "format": "date"},
        "finding": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "decided_at", "basis", "scope", "conditions"],
      "properties": {
        "status": {"enum": ["conditionally-approved", "rejected", "pending"]},
        "authority": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date"},
        "basis": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "legal_limitation": {"type": "string", "minLength": 1},
    "next_review": {"type": "string", "minLength": 1}
  }
}
