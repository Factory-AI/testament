{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Factory-AI/testament/schemas/claims-ledger.schema.json",
  "title": "Testament claims-evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "validation_id",
    "version",
    "status_values",
    "architecture_source",
    "evidence",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "feature_id": {"const": "claims-ledger-and-normative-boundaries"},
    "validation_id": {"const": "VAL-READY-016"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status_values": {
      "const": [
        "proposed",
        "in-review",
        "supported",
        "contradicted",
        "blocked",
        "superseded"
      ]
    },
    "architecture_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "claim_pointers"],
      "properties": {
        "path": {"const": "policy/architecture.json"},
        "claim_pointers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "qualification",
        "path",
        "url",
        "publisher",
        "title",
        "version",
        "publication_date",
        "accessed_at",
        "sha256",
        "claim_supported",
        "accessibility",
        "tested_commit",
        "environment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVID-[A-Z0-9-]+$"
        },
        "qualification": {"enum": ["primary", "reproducible"]},
        "path": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "publication_date": {"type": ["string", "null"], "format": "date"},
        "accessed_at": {"type": "string", "format": "date"},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_supported": {"type": "string", "minLength": 1},
        "accessibility": {
          "enum": ["public-repository", "public-url"]
        },
        "tested_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_id", "statement", "effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_id": {"type": ["string", "null"]},
        "statement": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "role",
        "status",
        "reviewed_at",
        "independence"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "completed"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date"},
        "independence": {"type": "string", "minLength": 1}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "superseded_by", "history"],
      "properties": {
        "supersedes": {"type": ["string", "null"]},
        "superseded_by": {"type": ["string", "null"]},
        "history": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "source_path",
        "source_pointer",
        "claim",
        "observation",
        "inference",
        "evidence_ids",
        "contradictory_evidence",
        "uncertainty",
        "limitations",
        "owner",
        "review",
        "status",
        "supersession",
        "last_updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLAIM-(ARCH|RELEASE)-[A-Z0-9-]+$"
        },
        "category": {
          "enum": ["architecture-shaping", "release-blocking"]
        },
        "source_path": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "inference": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "contradictory_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contradiction"}
        },
        "uncertainty": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1},
        "review": {"$ref": "#/$defs/review"},
        "status": {
          "enum": [
            "proposed",
            "in-review",
            "supported",
            "contradicted",
            "blocked",
            "superseded"
          ]
        },
        "supersession": {"$ref": "#/$defs/supersession"},
        "last_updated": {"type": "string", "format": "date"}
      }
    }
  }
}
